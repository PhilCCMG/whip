# Copy to apps/web/.env.local (git-ignored) and adjust.

# Local dev against the real API (`wrangler dev` on :8787, `pnpm --filter @whip/web dev` on :5173).
# Vite proxies /api to http://localhost:8787 (see vite.config.ts). When set, every request sends
# `X-Whip-Dev-User: <value>` so the Worker's dev auth signs you in as that user. Never set in production.
VITE_DEV_USER=dev-player

# "1" swaps the network for the in-browser mock backend (`pnpm --filter @whip/web dev:mock` sets
# this via .env.mock). Leave unset to talk to the real API.
# VITE_API_MOCK=1
