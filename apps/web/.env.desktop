# `vite build --mode desktop` (pnpm --filter @whip/desktop build:web): the packaged Tauri client.
# The bundled SPA talks to the cloud API cross-origin with bearer tokens (docs/architecture/08-desktop.md).
VITE_API_BASE=https://playwhip.com
# Mode files beat .env.local: never send the dev identity header or use mocks from a desktop build.
VITE_DEV_USER=
VITE_API_MOCK=
# Staging / local override: create apps/web/.env.desktop.local (git-ignored), e.g.
#   VITE_API_BASE=http://localhost:8787
# (the API allows http://tauri.localhost only; localhost dev origins only when ENVIRONMENT=local).
