# `tauri dev` (pnpm --filter @whip/desktop dev): Vite dev server on :5173 inside the Tauri window.
# Same-origin through the Vite /api proxy to `wrangler dev` on :8787, so start `pnpm dev` (or the
# api's dev script) first. The desktop platform (bearer tokens, keyring, fullscreen) is active.
VITE_API_BASE=
VITE_API_MOCK=
# Optional: VITE_DEV_USER=dev-player in .env.desktop-dev.local to skip sign-in locally.
VITE_DEV_USER=
