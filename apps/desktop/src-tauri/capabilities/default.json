{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The WHIP main window: app info, fullscreen, quit/relaunch, signed updates, and opening allowlisted https links (Credits) in the system browser. App commands (session token, toggle_fullscreen) are allowed by default.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-fullscreen",
    "core:window:allow-is-fullscreen",
    "updater:default",
    "process:allow-exit",
    "process:allow-restart",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://creativecommons.org/*" },
        { "url": "https://freesound.org/*" },
        { "url": "https://playwhip.com/*" }
      ]
    }
  ]
}
